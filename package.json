{
  "name": "cedis-unb.github.io",
  "version": "1.0.0",
  "description": "Site institucional do CEDIS — Centro de Estudos, Desenvolvimento e Inovação em Software, Universidade de Brasília. Construído com Hugo, Tailwind CSS, Alpine.js e Pagefind. Baseado no tema TailBliss.",
  "private": true,
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "alpinejs": "^3.16.3",
    "pa11y-ci": "^4.1.1",
    "tailwindcss": "^4.3.3"
  },
  "scripts": {
    "update-i18n": "python3 scripts/update_i18n.py",
    "build:publications": "python3 scripts/build_publications.py",
    "check:publications": "python3 scripts/build_publications.py --check",
    "prestart:agenda-seed": "npm run build:publications",
    "start:agenda-seed": "HUGO_CEDIS_INCLUDE_DEV_DEFESAS=1 hugo server -d .hugo-server --disableFastRender",
    "prestart": "npm run build:publications",
    "start": "hugo server -d .hugo-server --disableFastRender",
    "build": "npm run build:publications && hugo --minify --cleanDestinationDir && pagefind --site docs",
    "audit:a11y": "pa11y-ci --config .pa11yci.json",
    "audit:lighthouse": "lhci autorun --config=lighthouserc.json",
    "audit:lighthouse-mobile": "lhci autorun --config=lighthouserc-mobile.json",
    "test": "npm run check:publications && python3 scripts/validate_content.py && python3 scripts/validate_i18n.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedis-unb/cedis-unb.github.io.git"
  },
  "keywords": [
    "cedis",
    "unb",
    "universidade-de-brasilia",
    "software-engineering",
    "research-center",
    "hugo",
    "tailwindcss",
    "alpinejs",
    "pagefind"
  ],
  "author": "CEDIS — Centro de Estudos, Desenvolvimento e Inovação em Software (UnB)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/cedis-unb/cedis-unb.github.io/issues"
  },
  "homepage": "https://cedis.unb.br/",
  "dependencies": {
    "braces": ">=3.0.3",
    "cross-spawn": "^7.0.6",
    "markdown-it-emoji": "^3.0.0",
    "pagefind": "^1.5.2"
  },
  "overrides": {
    "brace-expansion": ">=5.0.9",
    "cross-spawn": "^7.0.6",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "@lhci/utils": {
      "js-yaml": "^3.15.1"
    },
    "cosmiconfig": {
      "js-yaml": "^4.3.1"
    }
  },
  "packageManager": "npm@11.11.0"
}
